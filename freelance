<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Umang Doshi – Flutter Developer &amp; Graphic Designer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F5F6FB; --card:#FFFFFF; --ink:#141834; --muted:#5A6080; --line:#DDE0EE;
  --blue:#2B3BE0; --blue-ink:#FFFFFF; --pink:#FF5C8A; --pink-ink:#2A0613; --dark:#141834; --dark-ink:#F5F6FB;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#0E1022;--card:#171A33;--ink:#F0F1FA;--muted:#A3A8C7;--line:#2A2E50;--blue:#6F7CFF;--blue-ink:#0E1022;--pink:#FF7BA1;--dark:#1B1F42;--dark-ink:#F0F1FA}
}
:root[data-theme="dark"]{--bg:#0E1022;--card:#171A33;--ink:#F0F1FA;--muted:#A3A8C7;--line:#2A2E50;--blue:#6F7CFF;--blue-ink:#0E1022;--pink:#FF7BA1;--dark:#1B1F42;--dark-ink:#F0F1FA}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Figtree',system-ui,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:'Bricolage Grotesque','Figtree',sans-serif;margin:0;line-height:1.08}
a{color:var(--blue)}
a:focus-visible,.btn:focus-visible{outline:3px solid var(--pink);outline-offset:3px}
.wrap{max-width:1060px;margin:0 auto;padding:24px 24px 72px}
nav{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:60px}
.brand{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:20px}
.navlinks{display:flex;gap:22px;align-items:center;font-weight:500;font-size:15px}
.navlinks a{color:var(--ink);text-decoration:none}
.btn{display:inline-block;text-decoration:none;font-weight:700;font-size:15px;padding:12px 22px;border-radius:999px;border:2px solid transparent}
.btn-blue{background:var(--blue);color:var(--blue-ink)}
.btn-line{border-color:var(--ink);color:var(--ink)}
.btn-pink{background:var(--pink);color:var(--pink-ink)}
.btn:hover{filter:brightness(1.08)}

.hero{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}
.hero h1{font-size:clamp(38px,6.2vw,68px);font-weight:800;letter-spacing:-.02em}
.hero .sub{font-size:18px;color:var(--muted);max-width:540px;margin:22px 0 30px}
.hero .cta{display:flex;flex-wrap:wrap;gap:12px}
.quick{margin:30px 0 0;color:var(--muted);font-size:15px}
.quick b{color:var(--ink)}

.stage{position:relative;height:380px}
.phone{position:absolute;left:8%;top:0;width:190px;height:360px;border-radius:32px;background:var(--blue);padding:14px;box-shadow:0 20px 40px rgba(20,24,52,.22)}
.phone .screen{height:100%;border-radius:20px;background:var(--card);padding:14px;display:flex;flex-direction:column;gap:10px}
.phone .b{height:12px;border-radius:6px;background:var(--line)}
.phone .b.w{width:60%}.phone .b.s{width:35%;background:var(--blue)}
.phone .blk{flex:1;border-radius:12px;background:var(--line)}
.phone .blk.alt{flex:.7;background:color-mix(in srgb,var(--pink) 55%,var(--card))}
.frame{position:absolute;right:0;bottom:0;width:78%;aspect-ratio:16/10;border-radius:14px;background:var(--dark);border:6px solid var(--pink);display:grid;place-items:center;box-shadow:0 20px 40px rgba(20,24,52,.22)}
.frame i{width:0;height:0;border-left:30px solid var(--dark-ink);border-top:19px solid transparent;border-bottom:19px solid transparent;margin-left:8px}
.frame span{position:absolute;left:14px;bottom:10px;color:var(--dark-ink);font-weight:700;font-size:14px}

section{margin-top:96px}
.head{margin-bottom:28px}
.head h2{font-size:clamp(28px,4.4vw,42px);font-weight:800;letter-spacing:-.01em}
.head p{color:var(--muted);max-width:560px;margin:10px 0 0}

.app{display:grid;grid-template-columns:240px 1fr;gap:10px 32px;padding:24px 0;border-top:2px solid var(--line)}
.app:last-child{border-bottom:2px solid var(--line)}
.app h3{font-size:22px}
.app .kind{color:var(--muted);font-size:14.5px;margin-top:4px}
.app p{margin:0 0 10px;max-width:600px}
.links{display:flex;flex-wrap:wrap;gap:6px 18px;font-weight:700;font-size:15px;margin:4px 0 10px}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tag{font-size:13px;background:var(--card);border:1px solid var(--line);color:var(--muted);padding:3px 10px;border-radius:999px}

.twocol{display:grid;grid-template-columns:1fr 1fr;gap:36px}
.skills h3{font-size:22px;margin-bottom:12px}
.skills ul{list-style:none;margin:0;padding:0}
.skills li{padding:11px 0;border-top:1px solid var(--line)}
.skills li b{display:block}
.skills li span{color:var(--muted);font-size:15px}
.skills.des h3{border-left:6px solid var(--pink);padding-left:12px}
.skills.dev h3{border-left:6px solid var(--blue);padding-left:12px}

.yt{margin-top:96px;background:var(--dark);color:var(--dark-ink);border-radius:24px;padding:48px 40px;display:grid;grid-template-columns:1fr auto;gap:28px;align-items:center}
.yt h2{font-size:clamp(28px,4.4vw,42px);font-weight:800}
.yt p{margin:14px 0 0;max-width:520px;opacity:.88}
.yt .play{width:120px;height:84px;border-radius:20px;background:var(--pink);display:grid;place-items:center}
.yt .play i{border-left:26px solid var(--pink-ink);border-top:16px solid transparent;border-bottom:16px solid transparent;margin-left:6px}
.yt .actions{margin-top:24px}

.hire{margin-top:96px;background:var(--card);border:2px solid var(--line);border-radius:24px;padding:48px 40px}
.hire h2{font-size:clamp(28px,4.6vw,44px);font-weight:800;max-width:600px}
.hire p{color:var(--muted);max-width:520px;margin:14px 0 26px}
.hire .actions{display:flex;flex-wrap:wrap;gap:12px}
.steps{margin:28px 0 0;padding:0;list-style:none;display:grid;gap:8px;font-size:15.5px}
.contact{margin-top:26px;color:var(--muted);font-size:15px}
footer{margin-top:44px;color:var(--muted);font-size:14px}

@media (max-width:800px){
  .hero,.twocol,.yt{grid-template-columns:1fr}
  .app{grid-template-columns:1fr}
  .stage{height:340px}
  .navlinks a.hide{display:none}
  .yt,.hire{padding:34px 24px}
  .yt .play{display:none}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
